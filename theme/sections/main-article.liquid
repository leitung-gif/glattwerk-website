<article class="sec sec-first">
  <div class="wrap" style="max-width:820px">
    <div class="rv">
      <p class="post-meta"><a href="{{ blog.url }}">{{ blog.title }}</a> · {{ article.published_at | date: '%d.%m.%Y' }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</p>
      <h1>{{ article.title }}</h1>
    </div>
    {%- if article.image -%}
      <div class="arch rv d1" style="margin:2.4rem 0">
        {{ article.image | image_url: width: 1400 | image_tag: alt: article.title }}
      </div>
    {%- endif -%}
    <div class="rte rv d1" style="max-width:none">{{ article.content }}</div>
    <div class="btn-row rv">
      <a class="btn btn-line" href="{{ blog.url }}">← Alle Beiträge</a>
      {%- if settings.whatsapp_number != blank -%}
        <a class="btn btn-ink" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">Termin buchen</a>
      {%- endif -%}
    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "@id": "{{ shop.url }}/#business" },
    {%- if article.image -%}"image": "{{ article.image | image_url: width: 1200 }}",{%- endif -%}
    "mainEntityOfPage": "{{ shop.url }}{{ article.url }}"
  }
  </script>
</article>

{% schema %}
{ "name": "Blog-Beitrag", "settings": [] }
{% endschema %}
