<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Laufband",
  "blocks": [
    { "type": "item", "name": "Begriff", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Diodenlaser-Haarentfernung" } ] }
  ],
  "max_blocks": 12,
  "presets": [{
    "name": "Laufband",
    "blocks": [
      { "type": "item", "settings": { "text": "Diodenlaser-Haarentfernung" } },
      { "type": "item", "settings": { "text": "Circadia Facials" } },
      { "type": "item", "settings": { "text": "Microneedling" } },
      { "type": "item", "settings": { "text": "Brow & Lash Lifting" } },
      { "type": "item", "settings": { "text": "Hochzeits-Make-up" } },
      { "type": "item", "settings": { "text": "Farb- & Stilberatung" } },
      { "type": "item", "settings": { "text": "Dermaplaning" } },
      { "type": "item", "settings": { "text": "Homecare-Beratung" } }
    ]
  }]
}
{% endschema %}
