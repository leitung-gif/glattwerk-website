{%- comment -%}
  Platzhalter für Standard-Templates, die dieses Studio-Theme (noch) nicht
  gestaltet: Produkt, Kollektion, Warenkorb, Blog usw. Wird relevant, sobald
  Gutscheine oder Circadia-Produktverkauf aufgeschaltet werden.
{%- endcomment -%}
<section class="sec sec-first">
  <div class="wrap center">
    <h1 class="rv">{{ section.settings.heading | default: page_title }}</h1>
    <p class="lede rv d1" style="margin:1.4rem auto 0">{{ section.settings.text }}</p>
    <div class="btn-row rv d2" style="justify-content:center">
      <a class="btn btn-ink" href="{{ routes.root_url }}">Zur Startseite</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Platzhalter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Dieser Bereich ist noch nicht eingerichtet." }
  ]
}
{% endschema %}
