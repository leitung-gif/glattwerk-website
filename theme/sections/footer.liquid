<footer class="site-footer">
  <div class="foot-grid">
    <div>
      <img src="{{ 'logo.png' | asset_url }}" alt="" width="56" height="56" style="margin-bottom:1rem">
      <p>{{ section.settings.tagline }}</p>
    </div>
    <div>
      <h5>Studio</h5>
      <p>{{ settings.address | newline_to_br }}<br>{{ settings.hours }}</p>
    </div>
    <div>
      <h5>Kontakt</h5>
      <ul>
        {%- if settings.phone_display != blank -%}<li><a href="tel:{{ settings.phone_e164 }}">{{ settings.phone_display }}</a></li>{%- endif -%}
        {%- if settings.email != blank -%}<li><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>{%- endif -%}
        {%- if settings.instagram_url != blank -%}<li><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">{{ settings.instagram_handle }}</a></li>{%- endif -%}
      </ul>
    </div>
    <div>
      <h5>Angebot</h5>
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <div class="foot-legal">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    {%- for link in section.settings.legal_menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </div>
  <span class="foot-word" aria-hidden="true">{{ section.settings.big_word }}</span>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Kurzbeschrieb", "default": "Dein Studio für Laser-Haarentfernung, Kosmetik und Styling in Spreitenbach." },
    { "type": "link_list", "id": "menu", "label": "Angebots-Menü", "default": "footer" },
    { "type": "link_list", "id": "legal_menu", "label": "Rechtliches-Menü" },
    { "type": "text", "id": "big_word", "label": "Riesen-Wordmark", "default": "Glattwerk Beauty" }
  ]
}
{% endschema %}
