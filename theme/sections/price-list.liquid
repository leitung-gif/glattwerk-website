{%- comment -%}
  Preisliste mit optionalen Tabs (z. B. Damen/Herren).
  Blocks: "group" beginnt eine neue Spalte mit Überschrift, "row" ist eine Preiszeile.
  Jeder Block hat ein Tab-Feld; ohne Tabs alles auf "a" lassen.
{%- endcomment -%}
<section class="sec {% if section.settings.scheme == 'green' %}sec-green{% endif %}" id="{{ section.settings.anchor | default: section.id }}" data-pricelist>
  <div class="wrap">
    <div class="center rv">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    {%- if section.settings.show_tabs -%}
      <div class="tabbar rv">
        <button class="on" data-tab="a" type="button">{{ section.settings.tab_a_label }}</button>
        <button data-tab="b" type="button">{{ section.settings.tab_b_label }}</button>
      </div>
    {%- endif -%}

    {%- assign tabs = 'a,b' | split: ',' -%}
    {%- for tab in tabs -%}
      {%- unless section.settings.show_tabs and tab == 'b' and section.blocks == empty -%}
      <div class="pricebook {% if tab == 'a' %}on{% endif %}" data-tab="{{ tab }}" {% unless section.settings.show_tabs %}{% if tab == 'b' %}style="display:none"{% endif %}{% endunless %}>
        {%- assign open = false -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.tab != tab -%}{%- continue -%}{%- endif -%}
          {%- if block.type == 'group' -%}
            {%- if open -%}</table></div>{%- endif -%}
            {%- assign open = true -%}
            <div class="pcol rv" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><table class="prices">
          {%- elsif block.type == 'row' -%}
            {%- unless open -%}
              {%- assign open = true -%}
              <div class="pcol rv"><table class="prices">
            {%- endunless -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.label }}{% if block.settings.desc != blank %}<span class="desc">{{ block.settings.desc }}</span>{% endif %}</td>
              <td>{{ block.settings.price }}</td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
        {%- if open -%}</table></div>{%- endif -%}
      </div>
      {%- endunless -%}
    {%- endfor -%}

    {%- if section.settings.note != blank -%}<p class="price-note rv">{{ section.settings.note }}</p>{%- endif -%}
    {%- if settings.whatsapp_number != blank and section.settings.cta_label != blank -%}
      <div class="btn-row rv" style="justify-content:center">
        <a class="btn btn-ink" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Preisliste",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Preisliste" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Preise" },
    { "type": "text", "id": "anchor", "label": "Anker-ID (für Sprunglinks)" },
    { "type": "checkbox", "id": "show_tabs", "label": "Tabs anzeigen", "default": false },
    { "type": "text", "id": "tab_a_label", "label": "Tab A", "default": "Damen" },
    { "type": "text", "id": "tab_b_label", "label": "Tab B", "default": "Herren" },
    { "type": "textarea", "id": "note", "label": "Hinweis unter der Liste" },
    { "type": "text", "id": "cta_label", "label": "CTA-Button" },
    { "type": "select", "id": "scheme", "label": "Farbschema", "options": [ { "value": "light", "label": "Champagner" }, { "value": "green", "label": "Dunkelgrün" } ], "default": "light" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Gruppen-Titel",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Facials" },
        { "type": "select", "id": "tab", "label": "Tab", "options": [ { "value": "a", "label": "A (Standard/Damen)" }, { "value": "b", "label": "B (Herren)" } ], "default": "a" }
      ]
    },
    {
      "type": "row",
      "name": "Preiszeile",
      "settings": [
        { "type": "text", "id": "label", "label": "Behandlung", "default": "Behandlung" },
        { "type": "text", "id": "desc", "label": "Beschreibung (optional)" },
        { "type": "text", "id": "price", "label": "Preis", "default": "CHF 0.–" },
        { "type": "select", "id": "tab", "label": "Tab", "options": [ { "value": "a", "label": "A (Standard/Damen)" }, { "value": "b", "label": "B (Herren)" } ], "default": "a" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "Preisliste" }]
}
{% endschema %}
