    "tips": {
      "type": "tips",
      "settings": { "kicker": "Pflegetipps", "heading": "Nach dem Lasern: <em>so bleibt's schön.</em>", "cta_label": "Termin buchen" },
      "blocks": {
        "t1": { "type": "tip", "settings": { "title": "Direkt danach", "items": "Leichte Rötungen, Schwellungen oder Wärmegefühl sind normal\nBei Bedarf kühlen — kein Eis direkt auf die Haut\nBeruhigende Pflege: Aloe Vera oder Panthenol" } },
        "t2": { "type": "tip", "settings": { "title": "24–48 h vermeiden", "items": "Sauna, Dampfbad, Solarium, heisse Bäder\nSport und starkes Schwitzen\nMake-up, Parfum, alkoholhaltige Produkte auf den Arealen\nEnge Kleidung und Reibung" } },
        "t3": { "type": "tip", "settings": { "title": "Sonnenschutz", "items": "2 Wochen keine direkte Sonne\nTäglich LSF 50+\nKein Solarium zwischen den Behandlungen" } },
        "t4": { "type": "tip", "settings": { "title": "Haarwachstum", "items": "Haare fallen nach 7–21 Tagen von selbst aus\nNicht zupfen, wachsen oder epilieren\nRasieren erlaubt, sobald die Haut beruhigt ist" } },
        "t5": { "type": "tip", "settings": { "title": "Hautpflege", "items": "Milde, unparfümierte Produkte\n7 Tage kein Peeling, Retinol oder Fruchtsäuren\nHaut sauber und mit Feuchtigkeit versorgt halten" } },
        "t6": { "type": "tip", "settings": { "title": "Melde dich bei mir", "items": "Bei starken Schmerzen, Blasen oder Krusten\nRötungen über 48 Stunden\nUngewöhnlichen Reaktionen oder Unsicherheit" } }
      },
      "block_order": ["t1", "t2", "t3", "t4", "t5", "t6"]
    }
