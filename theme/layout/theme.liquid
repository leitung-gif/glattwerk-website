<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {%- assign seo_description = page_description | default: settings.seo_default_description -%}
  {% if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  {% # Open Graph / Social Cards %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {% if seo_description != blank %}<meta property="og:description" content="{{ seo_description | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{% if template.name == 'article' %}article{% else %}website{% endif %}">
  {%- if settings.seo_share_image -%}
    <meta property="og:image" content="{{ settings.seo_share_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  {% # Strukturierte Daten: Lokales Geschäft (SEO + KI-Suchen/GEO) %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
    "@id": "{{ shop.url }}/#business",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "image": "{{ 'studio-uebersicht.jpg' | asset_url | prepend: 'https:' | remove: 'https:https:' }}",
    "telephone": {{ settings.phone_e164 | json }},
    "email": {{ settings.email | json }},
    "priceRange": "CHF 25–980",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Industriestrasse 173a",
      "addressLocality": "Spreitenbach",
      "postalCode": "8957",
      "addressRegion": "AG",
      "addressCountry": "CH"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": {{ settings.geo_lat | default: '47.4167' }}, "longitude": {{ settings.geo_lng | default: '8.3667' }} },
    "areaServed": ["Spreitenbach", "Dietikon", "Limmattal", "Baden", "Wettingen", "Zürich"],
    "sameAs": [{{ settings.instagram_url | json }}],
    "knowsAbout": ["Laser-Haarentfernung", "Diodenlaser", "Kosmetik", "Facials", "Microneedling", "Make-up", "Farbberatung"]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,500&family=Jost:wght@300;400;500&display=swap">
  {{ content_for_header }}
  {% # Brand-Tokens aus den Theme-Settings %}
  <style>
    :root{
      --champagne:{{ settings.color_bg }};
      --card:{{ settings.color_card }};
      --ink:{{ settings.color_ink }};
      --ink-soft:{{ settings.color_ink_soft }};
      --green:{{ settings.color_green }};
      --gold:{{ settings.color_gold }};
      --gold-deep:{{ settings.color_gold_deep }};
      --gold-bright:{{ settings.color_gold_bright }};
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>
  {% section 'header' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}

  <div class="mobile-bar">
    {%- if settings.phone_e164 != blank -%}<a class="mb-call" href="tel:{{ settings.phone_e164 }}">📞 Anrufen</a>{%- endif -%}
    {%- if settings.whatsapp_number != blank -%}<a class="mb-book" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">Termin buchen</a>{%- endif -%}
  </div>

  {% if settings.whatsapp_number != blank %}
  <a class="fab" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp öffnen">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.6.1-.8l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.3 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2 0-.1-.2-.2-.5-.3Z"/></svg>
  </a>
  {% endif %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
